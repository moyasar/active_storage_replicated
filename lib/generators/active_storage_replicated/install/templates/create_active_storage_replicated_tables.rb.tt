class CreateActiveStorageReplicatedTables < ActiveRecord::Migration<%= migration_version %>
  def change
    create_table :<%= tasks_table %> do |t|
      t.string :service_name, null: false
      t.string :target, null: false
      t.integer :operation, null: false
      t.string :key, null: false
      t.string :source
      t.integer :state, null: false, default: 0
      t.integer :attempts, null: false, default: 0
      t.text :last_error
      t.datetime :run_after, null: false
      t.datetime :claimed_until
      t.string :claimed_by
      t.timestamps

      t.index [ :service_name, :target, :operation, :id ], where: "state = 0", name: "index_<%= tasks_table %>_queue"
      t.index [ :service_name, :target, :operation, :run_after ], where: "state = 0", name: "index_<%= tasks_table %>_due"
      t.index [ :service_name, :key, :target ], where: "state = 0", name: "index_<%= tasks_table %>_pending"
      t.index [ :service_name, :key ], where: "state = 0", opclass: { key: :text_pattern_ops }, name: "index_<%= tasks_table %>_prefix"
      t.index [ :service_name, :key ], where: "state = 1 AND operation IN (1, 2)", name: "index_<%= tasks_table %>_tombstones"
      t.index :updated_at, where: "state <> 0", name: "index_<%= tasks_table %>_finished"
      t.index :service_name, where: "operation = 2 AND key NOT LIKE '%/'", name: "index_<%= tasks_table %>_prefix_deletes"
    end

    create_table :<%= audits_table %> do |t|
      t.string :service_name, null: false
      t.date :run_on, null: false
      t.datetime :started_at, null: false
      t.datetime :heartbeat_at, null: false
      t.datetime :finished_at
      t.integer :attempts, null: false, default: 1
      t.jsonb :summary
      t.text :error
      t.timestamps

      t.index [ :service_name, :run_on ], unique: true
    end
  end
end
